# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and populate your actual values.
# ==============================================================================

# Google Gemini API Key (Required for Multimodal Vision & Item Discrepancy Parsing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Anti-Fraud & Risk Thresholds
FRAUD_HARD_REJECT_THRESHOLD=0.80
FRAUD_MANUAL_REVIEW_THRESHOLD=0.40
PHASH_HAMMING_DISTANCE_LIMIT=4
MAX_TIMESTAMP_DELTA_SECONDS=7200

# Commercial / Financial Constants
DELIVERY_FEE=49.0
PLATFORM_FEE=5.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=production
